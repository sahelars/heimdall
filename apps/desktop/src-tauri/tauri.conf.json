{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall",
  "version": "0.1.0",
  "identifier": "io.slarsen.heimdall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/heimdall"
    ],
    "resources": [],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Setup and diagnostics for Heimdall vaults.",
    "longDescription": "Heimdall creates and edits Markdown vaults and makes the local MCP server available to AI clients."
  }
}
