{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall",
  "version": "0.1.0",
  "identifier": "io.slarsen.heimdall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 15, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/Icon.icon"
    ],
    "externalBin": [
      "binaries/heimdall"
    ],
    "resources": { "../../../LICENSE": "LICENSE" },
    "copyright": "© 2026 Sam Larsen. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Markdown vaults your AI can read and write, and you can lock.",
    "longDescription": "Heimdall edits Markdown vaults and serves them to AI clients over a local MCP server with two verbs, read and write. Any note, folder, or the whole vault can be locked read-only.",
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
